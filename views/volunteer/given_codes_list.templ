package pages

import (
	"fmt"
	"reyes-magos-gr/lib"
	"reyes-magos-gr/store/models"
	"reyes-magos-gr/views/components"
	svg "reyes-magos-gr/views/components/svg"
	"strings"
)

templ GivenCodesList(codes []models.Code) {
	{{
		var codeStrings []string
		for _, code := range codes {
			codeStrings = append(codeStrings, code.Code)
		}
		allCodes := strings.Join(codeStrings, ", ")
	}}
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
		<div class="text-center mb-8">
			<div class="inline-flex items-center justify-center w-16 h-16 bg-chip rounded-full mb-4">
				@svg.Gift("h-8 w-8 fill-primary")
			</div>
			<h2 class={ components.DSHeading2 + " mb-2" }>¡Códigos Listos para Regalar!</h2>
			<p class={ components.DSBody }>
				{ fmt.Sprintf("%d código(s) marcado(s) como regalado(s)", len(codes)) }
			</p>
		</div>
		<div class="rounded-chip bg-chip p-4 mb-8">
			<p class="font-sans text-sm text-ink text-center">
				Usa los botones de abajo para copiar o compartir todos los códigos con las familias
			</p>
		</div>
		<div class="bg-surface rounded-chip shadow-sm border border-border overflow-hidden mb-8">
			<div class="p-6">
				<h3 class="font-sans text-sm font-semibold text-muted mb-4">Códigos:</h3>
				<ul class="space-y-2 mb-6">
					for i, code := range codes {
						<li class="flex items-center gap-3">
							<span class="shrink-0 w-6 h-6 flex items-center justify-center bg-chip text-ink text-xs font-sans font-medium rounded-full">
								{ fmt.Sprintf("%d", i+1) }
							</span>
							<span class="font-mono text-lg text-ink">{ code.Code }</span>
							<span class="font-sans text-sm text-muted">- Expira: { lib.FormatDate(code.Expiration) }</span>
						</li>
					}
				</ul>
				<div class="border-t border-border pt-6 flex gap-4 justify-center">
					<button
						type="button"
						class={ components.DSButtonOutline }
						onclick={ onCopyHandler(allCodes) }
					>
						@svg.Clipboard("h-5 w-5 fill-current")
						<span>Copiar Todos</span>
					</button>
					<button
						type="button"
						class={ components.DSButtonPrimary }
						onclick={ onShareHandler(allCodes) }
					>
						@svg.Share("h-5 w-5 fill-current")
						<span>Compartir Todos</span>
					</button>
				</div>
			</div>
		</div>
		<div class="text-center">
			<a
				href="/volunteer/mycodes"
				class={ components.DSButtonOutline }
			>
				Recargar mis codigos
			</a>
		</div>
	</div>
}
