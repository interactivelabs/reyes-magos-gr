package pages

import (
	"fmt"
	"reyes-magos-gr/lib"
	"reyes-magos-gr/store/models"
	"reyes-magos-gr/views/admin"
	"reyes-magos-gr/views/components"
	"strings"
)

func toyCategories(toy models.Toy) []string {
	if toy.Category == "" {
		return nil
	}

	parts := strings.Split(toy.Category, ",")
	categories := make([]string, 0, len(parts))
	for _, part := range parts {
		if trimmed := strings.TrimSpace(part); trimmed != "" {
			categories = append(categories, trimmed)
		}
	}
	return categories
}

func ToyCountLabel(count int) string {
	if count == 1 {
		return "1 juguete"
	}
	return fmt.Sprintf("%d juguetes", count)
}

templ ToyRow(toy models.Toy) {
	<tr class="border-b border-chip" id={ fmt.Sprintf("admin-toys-row-%d", toy.ToyID) }>
		<td class="px-5 py-4 align-top">
			<div class="font-heading text-[15px] font-bold text-ink line-clamp-3 wrap-break-word">{ toy.ToyName }</div>
		</td>
		<td class="px-5 py-4 align-top">
			<div class="flex flex-wrap gap-1.5">
				for _, category := range toyCategories(toy) {
					<span class="rounded-pill bg-chip px-2.5 py-1 text-[12px] font-semibold text-secondary-shadow">{ category }</span>
				}
			</div>
		</td>
		<td class="px-5 py-4 align-top text-[13px] leading-relaxed text-muted">
			<p class="line-clamp-3 wrap-break-word">{ toy.ToyDescription }</p>
		</td>
		<td class="px-5 py-4 align-top">
			<a
				class="font-semibold text-accent"
				href={ templ.URL(toy.SourceURL) }
				target="_blank"
				rel="noopener noreferrer"
				referrerpolicy="no-referrer"
			>
				Ver
			</a>
		</td>
		<td class="whitespace-nowrap px-5 py-4 text-right align-top">
			<a
				class="font-semibold text-accent"
				href={ lib.GetSafeIdUrl("/admin/toys/%d", toy.ToyID) }
			>
				Editar
			</a>
			<span class="px-2 text-border">|</span>
			<a
				class="font-semibold text-secondary"
				href="#"
				hx-delete={ lib.GetSafeIdUrl("/admin/toys/%d/delete", toy.ToyID) }
				hx-confirm="¿Seguro que deseas eliminar este juguete?"
				hx-target={ fmt.Sprintf("#admin-toys-row-%d", toy.ToyID) }
			>
				Eliminar
			</a>
		</td>
	</tr>
}

templ ToySearchResults(toys []models.Toy, resultLabel string) {
	<div class="border-b border-border bg-background px-5 py-2.5 font-sans text-[13px] text-muted">
		{ resultLabel }
	</div>
	if len(toys) == 0 {
		<div class="px-6 py-14 text-center">
			<p class={ components.DSHeading3 }>Sin resultados</p>
			<p class={ components.DSBody + " text-muted" }>Ningún juguete coincide con esa búsqueda.</p>
		</div>
	} else {
		<div class="overflow-x-auto">
			<table class="w-full min-w-180 table-fixed border-collapse text-sm">
				<colgroup>
					<col class="w-[35%]"/>
					<col class="w-[15%]"/>
					<col class="w-[35%]"/>
					<col class="w-[5%]"/>
					<col class="w-[10%]"/>
				</colgroup>
				<thead>
					<tr class="border-b border-border">
						<th class="px-5 py-3 text-left font-heading text-xs font-bold uppercase tracking-wide text-muted">Nombre</th>
						<th class="px-5 py-3 text-left font-heading text-xs font-bold uppercase tracking-wide text-muted">Categoría</th>
						<th class="px-5 py-3 text-left font-heading text-xs font-bold uppercase tracking-wide text-muted">Descripción</th>
						<th class="px-5 py-3 text-left font-heading text-xs font-bold uppercase tracking-wide text-muted">Enlace</th>
						<th class="px-5 py-3 text-right font-heading text-xs font-bold uppercase tracking-wide text-muted">Acciones</th>
					</tr>
				</thead>
				<tbody id="admin-toys-table-body">
					for _, toy := range toys {
						@ToyRow(toy)
					}
				</tbody>
			</table>
		</div>
	}
}

templ Toys(toys []models.Toy, resultLabel string, search string) {
	@admin.AdminLayout() {
		<main class="bg-background min-h-screen">
			<div class="container mx-auto px-6 py-10 lg:px-8">
				<div class="mb-7 flex flex-wrap items-end justify-between gap-4">
					<div>
						<h1 class={ components.DSHeading1 }>Juguetes</h1>
						<p class={ components.DSBody + " text-muted" }>Lista de todos los juguetes activos en el catálogo.</p>
					</div>
					<a class={ components.DSButtonPrimary } href={ string(templ.URL("/admin/toys/create")) }>Agregar juguete</a>
				</div>
				<div class="overflow-hidden rounded-image border border-border bg-surface">
					<div class="flex flex-wrap items-center gap-3.5 border-b border-border bg-background px-5 py-4">
						<div class="w-70">
							<input
								type="text"
								name="q"
								value={ search }
								placeholder="Buscar por nombre o categoría…"
								class={ components.DSInput }
								hx-get="/admin/toys"
								hx-trigger="input changed delay:300ms, search"
								hx-target="#toys-table-region"
								hx-swap="innerHTML"
								hx-push-url="true"
							/>
						</div>
					</div>
					<div id="toys-table-region">
						@ToySearchResults(toys, resultLabel)
					</div>
				</div>
			</div>
		</main>
	}
}
