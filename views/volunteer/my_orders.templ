package pages

import (
	"fmt"
	"reyes-magos-gr/lib"
	"reyes-magos-gr/store/models"
	"reyes-magos-gr/views/components"
	svg "reyes-magos-gr/views/components/svg"
)

func pendingOrdersLabel(count int) string {
	if count == 1 {
		return "orden pendiente"
	}
	return "órdenes pendientes"
}

func orderStatusText(order models.Order) string {
	if order.Completed == 1 {
		return "Completada"
	}
	if order.Shipped == 1 {
		return "Enviado"
	}
	return "Nueva"
}

func orderStatusChipClass(order models.Order) string {
	if order.Completed == 1 {
		return "bg-disabled text-muted"
	}
	if order.Shipped == 1 {
		return "bg-[#fce8dd] text-primary-shadow"
	}
	return "bg-chip text-secondary-shadow"
}

func orderShippedReached(order models.Order) bool {
	return order.Shipped == 1 || order.Completed == 1
}

func orderCompletedReached(order models.Order) bool {
	return order.Completed == 1
}

func orderTimelineDotClass(reached bool) string {
	if reached {
		return "bg-primary border-primary"
	}
	return "bg-surface border-border"
}

func orderTimelineIconClass(reached bool) string {
	if reached {
		return "fill-white"
	}
	return "fill-disabled-text"
}

func orderTimelineLineClass(reached bool) string {
	if reached {
		return "bg-primary"
	}
	return "bg-border"
}

templ MyOrderCard(order models.Order) {
	<li class="flex flex-col gap-4 rounded-image border border-border bg-surface p-5.5 shadow-sm" id={ fmt.Sprintf("order-card-%d", order.OrderID) }>
		<div class="flex items-center justify-between">
			<span class="font-mono text-xs text-disabled-text">Orden #{ fmt.Sprint(order.OrderID) }</span>
			<span class={ "rounded-pill px-3 py-1.25 font-heading text-[11px] font-bold uppercase tracking-wide " + orderStatusChipClass(order) }>
				{ orderStatusText(order) }
			</span>
		</div>
		<div class="flex items-start">
			<div class="flex w-9 flex-col items-center gap-1.5">
				<div class={ "flex h-7 w-7 items-center justify-center rounded-pill border-2 " + orderTimelineDotClass(true) }>
					@svg.Box("h-3 w-3 " + orderTimelineIconClass(true))
				</div>
				<span class="text-center text-[10px] leading-tight text-muted">Ordenado</span>
			</div>
			<div class={ "mt-3.5 h-0.5 flex-1 -mx-0.5 " + orderTimelineLineClass(orderShippedReached(order)) }></div>
			<div class="flex w-9 flex-col items-center gap-1.5">
				<div class={ "flex h-7 w-7 items-center justify-center rounded-pill border-2 " + orderTimelineDotClass(orderShippedReached(order)) }>
					@svg.Truck("h-3 w-3 " + orderTimelineIconClass(orderShippedReached(order)))
				</div>
				<span class="text-center text-[10px] leading-tight text-muted">Enviado</span>
			</div>
			<div class={ "mt-3.5 h-0.5 flex-1 -mx-0.5 " + orderTimelineLineClass(orderCompletedReached(order)) }></div>
			<div class="flex w-9 flex-col items-center gap-1.5">
				<div class={ "flex h-7 w-7 items-center justify-center rounded-pill border-2 " + orderTimelineDotClass(orderCompletedReached(order)) }>
					@svg.CheckCircle("h-3 w-3 " + orderTimelineIconClass(orderCompletedReached(order)))
				</div>
				<span class="text-center text-[10px] leading-tight text-muted">Completado</span>
			</div>
		</div>
		<div class="flex flex-col gap-2 border-t border-border pt-3">
			<p class="flex items-center gap-2 text-[13px]">
				@svg.CalendarDays("h-3.5 w-3.5 shrink-0 fill-muted")
				<span class="text-muted">Fecha de orden:</span>
				<span class="font-semibold text-ink">{ lib.FormatDate(order.OrderDate) }</span>
			</p>
			<p class="flex items-center gap-2 text-[13px]">
				@svg.Truck("h-3.5 w-3.5 shrink-0 fill-muted")
				<span class="text-muted">Enviado:</span>
				<span class="font-semibold text-ink">{ components.HasOrderShipped(order) }</span>
			</p>
		</div>
		if order.Shipped == 1 && order.Completed != 1 {
			<button
				type="button"
				class={ components.DSButtonPrimary + " w-full" }
				hx-post={ lib.GetSafeIdUrl("/volunteer/myorders/%d/completed", order.OrderID) }
				hx-target={ fmt.Sprintf("#order-card-%d", order.OrderID) }
				hx-swap="outerHTML"
			>
				Completar
				@svg.CheckCircle("h-3.5 w-3.5 fill-current")
			</button>
		}
		if order.Completed == 1 {
			<div class="flex items-center justify-center gap-2 rounded-input bg-chip px-4 py-2.5 text-[13px] font-semibold text-muted">
				@svg.CheckCircle("h-3.5 w-3.5 fill-current")
				Completada
			</div>
		}
	</li>
}

templ MyOrders(orders []models.Order, recentlyCompletedOrders []models.Order) {
	@VolunteerLayout() {
		<main class="bg-surface min-h-screen">
			<section id="my_orders" class="relative isolate px-6 py-16 lg:px-8">
				<div class="max-w-5xl mx-auto">
					<div class="text-center">
						<h1 class={ components.DSHeading1 }>Mis Órdenes</h1>
						<p class="mt-1.5 text-[15px] text-muted">Aquí puedes ver el estado de tus regalos ordenados</p>
					</div>
					<div class="mt-7 mb-10 flex justify-center">
						<div class="inline-flex items-center gap-2.5 rounded-pill bg-chip px-5.5 py-2.5">
							@svg.Gift("h-4 w-4 fill-secondary")
							<span class="font-heading text-xl font-bold text-accent">{ fmt.Sprint(len(orders)) }</span>
							<span class="text-[13px] text-muted">{ pendingOrdersLabel(len(orders)) }</span>
						</div>
					</div>
					if len(orders) > 0 {
						<h2 class={ components.DSHeading3 + " mb-4.5" }>Órdenes sin completar</h2>
						<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
							for _, order := range orders {
								@MyOrderCard(order)
							}
						</ul>
					} else {
						<div class="rounded-image border border-border bg-surface px-6 py-16 text-center">
							<p class="font-heading text-lg font-bold text-ink">No tienes órdenes pendientes</p>
							<p class="mt-1.5 text-sm text-muted">Cuando ordenes un regalo, aparecerá aquí.</p>
						</div>
					}
					if len(recentlyCompletedOrders) > 0 {
						<h2 class={ components.DSHeading3 + " mt-16 mb-4.5" }>Órdenes Completadas Recientemente</h2>
						<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
							for _, order := range recentlyCompletedOrders {
								@MyOrderCard(order)
							}
						</ul>
					}
				</div>
			</section>
		</main>
	}
}
