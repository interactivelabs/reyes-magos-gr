package components

// D&L Toys Design Spec — "soft & hopeful" direction.
// Source: docs/DL Toys Design Spec.dc.html
//
// Kept separate from styles.templ on purpose: these are the new tokens for
// a phased migration. Existing views keep using the Base*/Brand* constants
// until they're moved over one page at a time; new/updated views use these.

// Buttons (spec §4) — flat "shadow-pop" style, radius-button (16px),
// Quicksand 700 14px, no uppercase. Press-state animation is an open
// question in the spec (§10) and intentionally not implemented here.
const DSButtonBase = "cursor-pointer inline-flex items-center justify-center gap-2 rounded-button font-heading font-bold text-sm "

const DSButtonPrimary = DSButtonBase + "bg-primary text-white px-6.5 py-3.5 shadow-primary "
const DSButtonSecondary = DSButtonBase + "bg-secondary text-white px-6 py-3.5 shadow-secondary "
const DSButtonOutline = DSButtonBase + "border-2 border-primary bg-transparent text-accent px-6 py-3 "
const DSButtonDisabled = DSButtonBase + "bg-disabled text-disabled-text px-6.5 py-3.5 cursor-not-allowed "

// attrs spreads onto the <button> (after class, so it can override type,
// add onclick/hx-*/id, etc.) — e.g.:
//   @components.DSPrimaryButton(templ.Attributes{"hx-post": "/cart", "id": "add-btn"}) {
//       Recibe un regalo
//   }
templ DSPrimaryButton(attrs templ.Attributes) {
	<button type="button" class={ DSButtonPrimary } { attrs... }>
		{ children... }
	</button>
}

templ DSSecondaryButton(attrs templ.Attributes) {
	<button type="button" class={ DSButtonSecondary } { attrs... }>
		{ children... }
	</button>
}

templ DSOutlineButton(attrs templ.Attributes) {
	<button type="button" class={ DSButtonOutline } { attrs... }>
		{ children... }
	</button>
}

templ DSDisabledButton(attrs templ.Attributes) {
	<button type="button" class={ DSButtonDisabled } disabled { attrs... }>
		{ children... }
	</button>
}

// Inputs & form controls (spec §5) — radius-input (14px), border-border by
// default, primary border + shadow-focus glow on focus.
const DSLabel = "block text-sm font-semibold text-ink "
const DSInput = "block w-full rounded-input border border-border bg-surface px-4 py-3 text-sm font-sans text-ink placeholder:text-muted focus:border-primary focus:outline-none focus:shadow-focus "

// Range sliders use the native input[type=range] with the primary accent
// color — no custom track/thumb needed.
const DSRangeInput = "w-full accent-primary "

// Checkboxes are wrapped in a pill-shaped chip rather than shown bare.
const DSChip = "inline-flex items-center gap-2 rounded-pill bg-chip px-4 py-2 text-[13px] font-sans text-ink "
const DSChipCheckbox = "accent-primary "

// Typography (spec §3) — Quicksand for display/headings, Cabin for body,
// Indie Flower (font-decorative, already themed) for the hero quote only.
const DSHeading1 = "font-heading font-bold text-ink text-[40px] leading-[1.2] "
const DSHeading2 = "font-heading font-bold text-ink text-[32px] leading-[1.2] "
const DSHeading3 = "font-heading font-semibold text-ink text-xl leading-[1.3] "
const DSBody = "font-sans text-ink text-base leading-relaxed "
const DSLabelText = "font-sans font-semibold text-[13px] leading-snug "
const DSNavLink = "font-sans font-semibold text-[13px] uppercase tracking-wide leading-none "
const DSHeroQuote = "font-decorative text-ink text-[32px] leading-[1.3] "

// Image frames (spec §8) — 20px radius, 1:1 placeholder for toy photos.
const DSImageFrame = "rounded-image object-cover "
