package pages

import (
	"fmt"
	"reyes-magos-gr/lib"
	layout "reyes-magos-gr/views"
	"reyes-magos-gr/views/components"
	svg "reyes-magos-gr/views/components/svg"
)

templ Home() {
	@layout.Base() {
		<main>
			<section id="hero" class="relative isolate overflow-hidden pt-14">
				<img
					src={ lib.GetAssetUrl("img/media/hero_v5.webp") }
					srcset={ fmt.Sprintf("%s 768w, %s 1280w, %s 1920w", lib.GetAssetUrl("img/media/hero_v5_sm.webp"), lib.GetAssetUrl("img/media/hero_v5.webp"), lib.GetAssetUrl("img/media/hero_v5_lg.webp")) }
					alt="Imagen de un niño jugando con un regalo"
					class="absolute inset-0 -z-10 size-full object-cover"
				/>
				<div class="mx-auto max-w-2xl my-32 sm:my-48 lg:my-56">
					<div class="bg-surface/90 rounded-chip text-center px-4 py-6 sm:px-8 sm:py-8 shadow-sm">
						<h1 class={ components.DSHeroQuote }>La inocente sonrisa de los niños es el lenguage universal de la bondad</h1>
						<div class="w-full text-right text-sm text-muted">- William Arthur Ward</div>
						<p class="mt-6 text-lg leading-8 text-primary">En este sitio podras recibir un regalo gratuito para un niño</p>
						<div class="mt-10 flex items-center justify-center gap-x-6">
							<a href="/catalog" class={ components.DSButtonPrimary } preload>Recibe un regalo</a>
							<a href="#steps" class={ components.DSButtonSecondary }>Ver como <span aria-hidden="true">→</span></a>
						</div>
					</div>
				</div>
			</section>
			<section id="steps" class="text-center mx-6 my-24 max-w-(--breakpoint-md) md:mx-auto">
				<div class="text-center mt-12 my-24">
					<h2 class={ components.DSHeading2 }>1. Obtener un codigo de regalo</h2>
					<p class={ "mt-4 " + components.DSBody }>Un voluntario te podra dar un codigo gratuito para poder recibir un regalo.</p>
					<div id="home-ilustracion-1" class="scroll-reveal">
						@svg.Code("mt-8 w-1/2 mx-auto")
					</div>
				</div>
				@components.Divider()
				<div class="text-center mt-12 my-24">
					<h2 class={ components.DSHeading2 }>2. Usa el codigo</h2>
					<p class={ "mt-4 " + components.DSBody }>Entra a este sitio y ve a la seccion de <a href="/catalog" class="font-semibold leading-6 text-accent underline" preload>catálogo</a>, donde podras ordernar el regalo gratuito.</p>
					<p class={ "mt-4 " + components.DSBody }>Si no tienes accesso a internet la persona voluntaria podra ayudarte en el momento.</p>
					<div id="home-ilustracion-2" class="scroll-reveal">
						@svg.Shop("mt-8 w-1/2 mx-auto")
					</div>
				</div>
				@components.Divider()
				<div class="text-center mt-12 my-24">
					<h2 class={ components.DSHeading2 }>3. Recibe el juegue</h2>
					<p class={ "mt-4 " + components.DSBody }>Una vez que se ordeno el regalo tomara unos dias para llegar al voluntario quien se encargara de hacertelo llegar.</p>
					<div id="home-ilustracion-3" class="scroll-reveal">
						@svg.OpenGift("mt-8 w-1/2 mx-auto")
					</div>
				</div>
				@components.Divider()
				<div class="text-center mt-12 my-24">
					<h2 class={ components.DSHeading2 }>!! Completamente Gratuito !!</h2>
					<p class={ "mt-4 " + components.DSBody }>
						El recivir un juegue es comopletamente gratuito, no debes remunerar de ninguna manera al voluntario de lo contrario por favor reporta a la persona a
						<a href="mailto:support@dl-toys.com" class="font-semibold leading-6 text-accent underline">support@dl-toys.com</a>
					</p>
				</div>
			</section>
			<section id="why" class="text-center my-24 max-w-(--breakpoint-md) md:mx-auto md:columns-2">
				<img src={ lib.GetAssetUrl("img/gift_wrap_md.webp") } loading="lazy" alt="Dos personas envolviendo un regalo" class="w-full object-cover my-24 md:my-0 rounded-image"/>
				<div class="text-center mx-6">
					<h2 class={ components.DSHeading2 }>Porque?</h2>
					<p class={ "mt-4 " + components.DSBody }>Somos un grupo de voluntarios que queremos ayudar a los niños a tener una sonrisa, simple y sencillamente porque creemos que es de las mejores cosas que tiene el mundo.</p>
					<p class={ "mt-4 " + components.DSBody }>
						De antemano agradecemos tu participasion ya sea como voluntario o como padre, si tienes alguna otra pregunta u ocupas reportar algo por favor escribenos a
						<a href="mailto:support@dl-toys.com" class="font-semibold leading-6 text-accent underline">support@dl-toys.com</a>
					</p>
				</div>
			</section>
			<section id="volunteers" class="text-center mx-6 my-24 max-w-(--breakpoint-md) md:mx-auto">
				<h2 class={ components.DSHeading2 }>Voluntarios</h2>
				<p class={ "mt-4 " + components.DSBody }>Las personas que nos ayudan a ordenar y distribuir los juguetges (los voluntarios), son individuos que nos ayudan sin fines de lucro, ellos no tienen la posibilidad de crear codigos y/o ordenar muchos juguetges a la vez</p>
				<p class={ "mt-4 " + components.DSBody }>Por favor respetalos y respeta su tiempo y su ezfuerso</p>
				<p class={ "mt-4 " + components.DSBody }>Si quieres ser voluntario por favor escribenos a <a href="mailto:support@dl-toys.com" class="font-semibold leading-6 text-accent underline">support@dl-toys.com</a></p>
			</section>
			<section id="bottom-cta" class="text-center mx-6 my-24 max-w-(--breakpoint-md) md:mx-auto">
				<a href="/catalog" class={ components.DSButtonPrimary } preload>Recibe un regalo</a>
			</section>
		</main>
	}
}
