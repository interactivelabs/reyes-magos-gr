package pages

import (
	"fmt"
	"reyes-magos-gr/store/models"
	"reyes-magos-gr/views/components"
	svg "reyes-magos-gr/views/components/svg"
)

func pendingOrdersLabel(count int) string {
	if count == 1 {
		return "orden pendiente"
	}
	return "órdenes pendientes"
}

templ MyOrders(orders []models.OrderDetails, recentlyCompletedOrders []models.OrderDetails) {
	@VolunteerLayout() {
		<main class="bg-surface min-h-screen">
			<section id="my_orders" class="relative isolate px-6 py-16 lg:px-8">
				<div class="max-w-5xl mx-auto">
					<div class="text-center">
						<h1 class={ components.DSHeading1 }>Mis Órdenes</h1>
						<p class="mt-1.5 text-[15px] text-muted">Aquí puedes ver el estado de tus regalos ordenados</p>
					</div>
					<div class="mt-7 mb-10 flex justify-center">
						<div class="inline-flex items-center gap-2.5 rounded-pill bg-chip px-5.5 py-2.5">
							@svg.Gift("h-4 w-4 fill-secondary")
							<span class="font-heading text-xl font-bold text-accent">{ fmt.Sprint(len(orders)) }</span>
							<span class="text-[13px] text-muted">{ pendingOrdersLabel(len(orders)) }</span>
						</div>
					</div>
					if len(orders) > 0 {
						<h2 class={ components.DSHeading3 + " mb-4.5" }>Órdenes sin completar</h2>
						<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
							for _, order := range orders {
								@components.OrderCard(order, false)
							}
						</ul>
					} else {
						<div class="rounded-image border border-border bg-surface px-6 py-16 text-center">
							<p class="font-heading text-lg font-bold text-ink">No tienes órdenes pendientes</p>
							<p class="mt-1.5 text-sm text-muted">Cuando ordenes un regalo, aparecerá aquí.</p>
						</div>
					}
					if len(recentlyCompletedOrders) > 0 {
						<h2 class={ components.DSHeading3 + " mt-16 mb-4.5" }>Órdenes Completadas Recientemente</h2>
						<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
							for _, order := range recentlyCompletedOrders {
								@components.OrderCard(order, false)
							}
						</ul>
					}
				</div>
			</section>
		</main>
	}
}
