package pages

import (
	"fmt"
	"reyes-magos-gr/store/models"
	"reyes-magos-gr/views/admin"
	"reyes-magos-gr/views/components"
)

templ Orders(orders []models.OrderDetails, completedOrders []models.OrderDetails) {
	@admin.AdminLayout() {
		<main class="bg-background min-h-screen">
			<div class="container mx-auto max-w-5xl px-6 py-10 lg:px-8">
				<div class="mb-7">
					<h1 class={ components.DSHeading1 }>Órdenes</h1>
					<p class={ components.DSBody + " text-muted" }>Administra el estado de envío y finalización de las órdenes.</p>
				</div>
				<div class="mb-9 grid grid-cols-1 gap-4 sm:grid-cols-3">
					<div class="rounded-chip border border-border bg-surface px-5 py-5">
						<div class="mb-1.5 font-sans text-xs font-semibold text-muted">Total de Órdenes</div>
						<div class={ components.DSHeading2 }>{ fmt.Sprint(len(orders) + len(completedOrders)) }</div>
					</div>
					<div class="rounded-chip border border-border bg-surface px-5 py-5">
						<div class="mb-1.5 font-sans text-xs font-semibold text-muted">Órdenes Abiertas</div>
						<div class={ components.DSHeading2 }>{ fmt.Sprint(len(orders)) }</div>
					</div>
					<div class="rounded-chip border border-border bg-surface px-5 py-5">
						<div class="mb-1.5 font-sans text-xs font-semibold text-muted">Órdenes Completadas</div>
						<div class={ components.DSHeading2 }>{ fmt.Sprint(len(completedOrders)) }</div>
					</div>
				</div>
				if len(orders) > 0 {
					<section class="mb-10">
						<h2 class={ components.DSHeading3 + " mb-4.5" }>Órdenes Abiertas</h2>
						<ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
							for _, order := range orders {
								<li id={ fmt.Sprintf("admin-order-%d", order.Order.OrderID) }>
									@components.OrderCard(order, true)
								</li>
							}
						</ul>
					</section>
				}
				if len(completedOrders) > 0 {
					<section>
						<h2 class={ components.DSHeading3 + " mb-4.5" }>Órdenes Completadas</h2>
						<ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
							for _, order := range completedOrders {
								<li id={ fmt.Sprintf("admin-order-%d", order.Order.OrderID) }>
									@components.OrderCard(order, true)
								</li>
							}
						</ul>
					</section>
				}
			</div>
		</main>
	}
}
