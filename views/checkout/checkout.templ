package pages

import (
	"fmt"
	"reyes-magos-gr/lib"
	"reyes-magos-gr/store/models"
	layout "reyes-magos-gr/views"
	"reyes-magos-gr/views/components"
	"reyes-magos-gr/views/components/svg"
	"strings"
	"unicode"
)

type toyHighlight struct {
	Title      string
	Paragraphs []string
}

// parseHighlightTitle extracts a title from description lines shaped like
// "🦖【Title】: body" or "UPPERCASE TITLE: body".
func parseHighlightTitle(line string) (string, string, bool) {
	if a, b := strings.Index(line, "【"), strings.Index(line, "】"); a >= 0 && b > a {
		title := strings.TrimSpace(line[a+len("【") : b])
		body := strings.TrimLeft(strings.TrimSpace(line[b+len("】"):]), ":： ")
		return title, body, title != ""
	}
	prefix, body, found := strings.Cut(line, ":")
	if !found || len(prefix) > 80 || strings.ToUpper(prefix) != prefix || !strings.ContainsFunc(prefix, unicode.IsLetter) {
		return "", "", false
	}
	return strings.TrimSpace(prefix), strings.TrimSpace(body), true
}

// getToyHighlights groups untitled description lines into a leading "Descripción" entry.
func getToyHighlights(toy models.Toy) []toyHighlight {
	general := toyHighlight{Title: "Descripción"}
	var titled []toyHighlight
	for _, line := range strings.Split(toy.ToyDescription, "\n") {
		line = strings.TrimSpace(line)
		if line == "" || line == toy.ToyName {
			continue
		}
		if title, body, ok := parseHighlightTitle(line); ok {
			titled = append(titled, toyHighlight{Title: title, Paragraphs: []string{body}})
		} else {
			general.Paragraphs = append(general.Paragraphs, line)
		}
	}
	if len(general.Paragraphs) > 0 {
		return append([]toyHighlight{general}, titled...)
	}
	return titled
}

templ RedeemToyForm(toyId int64, code string, errorMsg string) {
	<form
		class="flex flex-col gap-3.5 rounded-image border border-border bg-background p-5 lg:gap-4 lg:p-6"
		hx-post={ string(templ.URL("/orders/create")) }
		hx-on::before-request="beforeCheckoutHandler(event)"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<div>
			<h2 class="font-heading text-[17px] font-bold text-ink lg:text-lg">Ingresa tu código</h2>
			<p class="mt-1 font-sans text-sm text-muted">Ingresa el código que te dio tu voluntario.</p>
		</div>
		<div>
			<label for="code" class={ components.DSLabel }>Codigo</label>
			<input
				id="code"
				type="text"
				name="code"
				pattern="[A-Z1-9]+"
				placeholder="A1B2C3"
				class={ components.DSInput + " mt-2 tracking-[0.12em] max-lg:text-base" }
				onblur="onCodeInputBlur()"
				oninput="onCodeInputChange()"
				required
				value={ code }
			/>
			<input type="hidden" name="toy_id" value={ fmt.Sprint(toyId) }/>
			<p class="mt-2 text-sm font-sans text-red-600 hidden" id="code-error">Un codigo valido es requerido (e.g. A1B2C3)</p>
		</div>
		if errorMsg != "" {
			<div class="rounded-chip bg-red-50 p-4" id="backend-error">
				<div class="flex">
					<div class="shrink-0">
						@svg.ErrorIcon("size-5 text-red-400")
					</div>
					<div class="ml-3">
						<h3 class="text-sm font-sans font-medium text-red-800">
							{ errorMsg },
							<a href="/#steps" class="inline-block ml-1 underline font-bold">Ve aqui como obeter un codigo</a>
						</h3>
					</div>
				</div>
			</div>
		}
		<button type="submit" class={ components.DSButtonPrimary + " w-full max-lg:text-[15px]" }>
			Ordenar regalo
		</button>
		<a href="/#steps" class="py-1.5 text-center font-sans text-[13px] text-accent hover:text-primary-shadow lg:py-0">
			¿No tienes código? Ve aquí cómo obtener uno
		</a>
	</form>
}

templ AddToCartButton(toyId int64) {
	<form
		hx-post={ string(templ.URL("/volunteer/mycart")) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="toy_id" value={ fmt.Sprint(toyId) }/>
		<button
			type="submit"
			class={ components.DSButtonPrimary + " w-full" }
		>
			Agregar al Carrito
		</button>
	</form>
}

templ ToyGallery(toy models.Toy) {
	<h3 class="sr-only">Imagenes</h3>
	<img
		id="toy-image-0"
		src={ toy.Image1 }
		alt={ toy.ToyName }
		class="aspect-square w-full rounded-image border border-border bg-surface object-contain"
	/>
	<div class="px-2 md:px-0 mt-4 grid grid-cols-3 gap-4 lg:gap-8 justify-items-center">
		for i, src := range []string{toy.Image1, toy.Image2, toy.Image3} {
			<img
				id={ fmt.Sprintf("toy-image-%d", i+1) }
				src={ src }
				alt={ fmt.Sprintf("%s, imagen %d", toy.ToyName, i+1) }
				class={ components.DSImageFrame + " cursor-pointer max-h-37.5", templ.KV("border-4 border-primary brightness-90", i == 0) }
				onclick="selectToyImage(this)"
			/>
		}
	</div>
}

templ ToyHighlights(toy models.Toy) {
	if highlights := getToyHighlights(toy); len(highlights) > 0 {
		<div class="mt-2 lg:mt-0">
			<h2 class="mb-1 font-heading text-[17px] font-bold text-ink lg:text-lg">Lo que hace especial a este juguete</h2>
			for i, h := range highlights {
				<details class="group border-b border-border" open?={ i == 0 }>
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3.5 font-heading text-[15px] font-semibold text-ink select-none lg:py-4 lg:text-base [&::-webkit-details-marker]:hidden">
						<span class={ templ.KV("lowercase first-letter:uppercase", strings.ToUpper(h.Title) == h.Title) }>{ h.Title }</span>
						<span aria-hidden="true" class="text-lg leading-none text-muted transition duration-200 group-open:rotate-45">+</span>
					</summary>
					<div class="mb-3.5 flex flex-col gap-3 lg:mb-4">
						for _, p := range h.Paragraphs {
							<p class="font-sans text-[15px] leading-[1.65] text-ink text-pretty">{ p }</p>
						}
					</div>
				</details>
			}
		</div>
	}
}

templ Checkout(toy models.Toy, code string) {
	@layout.Base() {
		<main class="min-h-screen bg-surface">
			<div class="mx-auto max-w-2xl px-4 pb-28 pt-8 sm:px-6 lg:max-w-7xl lg:px-8">
				<div>
					<button class={ components.DSButtonOutline + " flex items-center" } onclick="history.back()">
						@svg.ArrowToLeft("h-5 w-5 fill-current")
						<span class="inline-block ml-1 tracking-widest">Regresar</span>
					</button>
				</div>
				<h1 class={ components.DSHeading2 + " mt-8 text-center lg:text-[40px]" }>Pedir regalo</h1>
				<div class="mt-5 flex flex-col gap-5 lg:mt-12 lg:grid lg:grid-cols-12 lg:items-start lg:gap-14">
					<div class="lg:col-span-7">
						@ToyGallery(toy)
					</div>
					<div class="flex flex-col gap-5 lg:col-span-5 lg:gap-7">
						<div class="flex flex-col gap-5 lg:gap-4">
							<div class="flex flex-wrap gap-1.5">
								for _, c := range strings.Split(toy.Category, ",") {
									<span class="rounded-pill bg-chip px-2.5 py-1 font-sans text-xs text-ink">{ strings.TrimSpace(c) }</span>
								}
							</div>
							<h2 class="font-heading text-[17px] font-bold leading-[1.4] text-ink text-pretty lg:text-[21px]">{ toy.ToyName }</h2>
						</div>
						<div class="flex items-center gap-3.5 rounded-image border border-border px-4.5 py-3.5 lg:gap-4 lg:px-5 lg:py-4">
							<span class="font-heading text-[30px] font-bold leading-none text-accent lg:text-4xl">{ fmt.Sprintf("%d–%d", toy.AgeMin, toy.AgeMax) }</span>
							<div class="flex flex-col gap-0.5">
								<span class="font-heading text-[15px] font-bold text-ink lg:text-base">años</span>
								<span class="font-sans text-[13px] text-muted lg:text-sm">Edad recomendada</span>
							</div>
						</div>
						if lib.IsVolunteersCartEnabled(ctx) {
							@AddToCartButton(toy.ToyID)
						} else {
							@RedeemToyForm(toy.ToyID, code, "")
						}
						@ToyHighlights(toy)
					</div>
				</div>
			</div>
		</main>
	}
}
