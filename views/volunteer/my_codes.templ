package pages

import (
	"fmt"
	"reyes-magos-gr/lib"
	"reyes-magos-gr/store/models"
	"reyes-magos-gr/views/components"
	svg "reyes-magos-gr/views/components/svg"
)

script onShareHandler(code string) {
  shareCode(code);
}

script onCopyHandler(code string) {
  copyCode(code);
}

templ MyCodeItem(code models.Code) {
	<li
		class="col-span-1 flex flex-col rounded-chip border border-border bg-surface shadow-sm overflow-hidden divide-y divide-border"
		id={ fmt.Sprintf("volunteer-code-%d", code.CodeID) }
	>
		<div class="p-4 flex-1">
			<p class="font-sans text-lg text-ink">{ code.Code }</p>
			<p class="font-sans text-sm text-muted">Exp: { lib.FormatDate(code.Expiration) }</p>
		</div>
		if code.Given == 1 {
			<div class="w-full p-2 text-center bg-chip text-muted text-sm font-sans font-semibold">
				Regalado
			</div>
			<div class="flex divide-x divide-border">
				<button
					type="button"
					class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2.5 font-sans text-xs font-semibold text-accent hover:bg-chip"
					onclick={ onCopyHandler(code.Code) }
				>
					Copiar
					@svg.Clipboard("h-4 w-4 fill-current")
				</button>
				<button
					type="button"
					class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2.5 font-sans text-xs font-semibold text-accent hover:bg-chip"
					onclick={ onShareHandler(code.Code) }
				>
					Comparitr
					@svg.Share("h-4 w-4 fill-current")
				</button>
			</div>
		} else {
			<button
				type="button"
				class="w-full inline-flex items-center justify-center gap-2 px-3 py-3 font-sans text-sm font-bold text-white bg-primary hover:opacity-90"
				hx-post={ lib.GetSafeIdUrl("/volunteer/mycodes/give/%d", code.CodeID) }
				hx-target={ fmt.Sprintf("#volunteer-code-%d", code.CodeID) }
			>
				Regalar
				@svg.Gift("h-4 w-4 fill-current")
			</button>
		}
	</li>
}

templ MyCodes(codes []models.Code, givenCodes []models.Code) {
	@VolunteerLayout() {
		<main class="bg-surface min-h-screen">
			<h1 class={ components.DSHeading1 + " text-center pt-8" }>Mis Codigos</h1>
			<section id="my_codes" class="relative isolate px-6 py-20 lg:px-8">
				<dl class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 max-w-2xl mx-auto">
					<div class="rounded-chip border border-border bg-surface px-4 py-5 shadow-sm sm:p-6 text-center">
						<dt class="font-sans text-sm text-muted">Codigos disponibles</dt>
						<dd class={ components.DSHeading2 + " mt-1" }>{ fmt.Sprint(len(codes)) }</dd>
					</div>
					<div class="rounded-chip border border-border bg-surface px-4 py-5 shadow-sm sm:p-6 text-center">
						<dt class="font-sans text-sm text-muted">Codigos regalados</dt>
						<dd class={ components.DSHeading2 + " mt-1" }>{ fmt.Sprint(len(givenCodes)) }</dd>
					</div>
				</dl>
				if len(codes) > 1 && lib.IsVolunteersCartEnabled(ctx) {
					<div class="py-16 sm:w-1/2">
						<h2 class={ components.DSHeading3 }>Regalar varios codigos</h2>
						<form
							id="give-codes"
							hx-post={ string(templ.URL("/volunteer/mycodes/give_codes")) }
							hx-indicator="#loading-spinner"
						>
							<div class="mt-4">
								<label for="codes_number" class={ components.DSLabel }>Numero de codigos</label>
							</div>
							<div class="mt-2">
								<input type="number" id="codes_number" name="codes_number" max={ len(codes) } class={ components.DSInput }/>
							</div>
							<div class="mt-4 text-right">
								<button class={ components.DSButtonPrimary + " inline-flex" }>
									<div id="loading-spinner" class="htmx-indicator">
										@svg.Spinner()
									</div>
									Regalar
									@svg.Gift("h-4 w-4 ml-4 fill-current")
								</button>
							</div>
						</form>
					</div>
				}
				if len(codes) > 0 {
					<div class="py-16">
						<h2 class={ components.DSHeading3 }>Codigos disponibles a regalar</h2>
						<ul role="list" id="mycodes-code-list" class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
							for _, code := range codes {
								@MyCodeItem(code)
							}
						</ul>
					</div>
				}
				if len(givenCodes) > 0 {
					<div class="py-16">
						<h2 class={ components.DSHeading3 }>Codigos regalados aun no utilizados</h2>
						<ul role="list" id="mycodes-code-list" class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
							for _, code := range givenCodes {
								@MyCodeItem(code)
							}
						</ul>
					</div>
				}
			</section>
		</main>
	}
}
