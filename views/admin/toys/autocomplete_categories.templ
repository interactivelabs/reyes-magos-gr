package pages

import (
	"reyes-magos-gr/store/dtos"
	"reyes-magos-gr/views/components"
	"strings"
)

func splitCategories(value string) []string {
	if value == "" {
		return nil
	}
	return strings.Split(value, ",")
}

templ AutocompleteCategories(currentValue string, categories []dtos.AutocompleteItem) {
	<div>
		@components.DSFieldLabel("category_search", "Categorías", false)
		<div class="relative">
			<el-autocomplete class="block">
				<input
					id="category_search"
					name="category_search"
					class={ components.DSInput }
				/>
				<el-options
					popover
					anchor="bottom end"
					class="max-h-56 w-(--input-width) overflow-auto rounded-input border border-border bg-surface py-1 text-base shadow-lg transition-discrete [--anchor-gap:--spacing(1)] sm:text-sm"
				>
					for _, c := range categories {
						<el-option
							value={ c.Value }
							class="block px-3 py-2 text-ink select-none aria-selected:bg-primary aria-selected:text-white"
						>{ c.Label }</el-option>
					}
				</el-options>
			</el-autocomplete>
			<button
				type="button"
				class="absolute inset-y-0 right-0 flex items-center rounded-r-input px-3 font-heading text-sm font-bold text-accent focus:outline-hidden"
				onclick="addCategory()"
			>Agregar</button>
		</div>
		<div class={ "mt-3 flex flex-wrap gap-2", templ.KV("hidden", currentValue == "") } id="category-chips">
			for _, cat := range splitCategories(currentValue) {
				@CategoryChip(cat)
			}
		</div>
		<input type="hidden" name="category" id="category" value={ currentValue }/>
	</div>
}

script onRemoveCategory(category string) {
	removeCategory(category);
}

templ CategoryChip(cat string) {
	<div data-category={ cat }>
		<span class={ components.DSChip }>
			<span>{ cat }</span>
			<button
				type="button"
				onclick={ onRemoveCategory(cat) }
				class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-pill text-muted hover:text-accent"
			>
				<span class="sr-only">Quitar categoría</span>
				<svg class="h-2 w-2" stroke="currentColor" fill="none" viewBox="0 0 8 8">
					<path stroke-linecap="round" stroke-width="1.5" d="M1 1l6 6m0-6L1 7"></path>
				</svg>
			</button>
		</span>
	</div>
}
